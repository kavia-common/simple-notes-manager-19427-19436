# Public API base presented to the browser.
# Option A: Point directly to backend (no dev proxy)
# NUXT_PUBLIC_NOTES_API_BASE=http://localhost:8000

# Option B: Use relative '/api' and enable dev proxy below
# (Default in nuxt.config.ts is /api if not set)
# NUXT_PUBLIC_NOTES_API_BASE=/api

# When using '/api' base, set this to enable dev proxy during `npm run dev`
# The dev server will forward /api/* to this backend URL.
# NUXT_BACKEND_URL=http://localhost:8000
