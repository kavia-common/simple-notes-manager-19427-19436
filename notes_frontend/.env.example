# Public runtime configuration for the Notes frontend
# Point to your backend REST API base URL (without trailing slash).
# If your backend runs at http://localhost:8000 and exposes /notes endpoints, use:
# NUXT_PUBLIC_NOTES_API_BASE=http://localhost:8000
# If the frontend is reverse-proxied to backend under /api, you can omit this.
NUXT_PUBLIC_NOTES_API_BASE=
